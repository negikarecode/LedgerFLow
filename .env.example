# Application
NODE_ENV=development
PORT=3000

# PostgreSQL (Use 5433 if host port 5432 is already occupied by a local postgres daemon)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ledgerflow
POSTGRES_PORT=5433
DATABASE_URL=postgres://postgres:postgres@localhost:5433/ledgerflow
DB_POOL_MAX=60

# Redis (Use 6380 if host port 6379 is already occupied by a local redis daemon)
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# Webhooks
WEBHOOK_SECRET=default-ledgerflow-secret-key-12345
ALLOW_PRIVATE_WEBHOOK_TARGETS=true

# Admin Bootstrap Authentication
ADMIN_TOKEN=default-admin-token-secret-99999

# Idempotency Layer Configuration
IDEMPOTENCY_RETENTION_SECONDS=86400
IDEMPOTENCY_CLEANUP_INTERVAL_SECONDS=3600

# Endpoint Isolation, Circuit Breaker & Rate Limiting
CIRCUIT_BREAKER_FAILURE_THRESHOLD=10
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
CIRCUIT_BREAKER_ERROR_RATE_THRESHOLD=0.5
WEBHOOK_RATE_LIMIT_PER_SECOND=10
WEBHOOK_RATE_LIMIT_BURST=20
WEBHOOK_MAX_CONCURRENT_PER_ENDPOINT=3
WEBHOOK_DELIVERY_TIMEOUT_MS=5000
WEBHOOK_WORKER_CONCURRENCY=10

# Observability & Metrics
LOG_LEVEL=info
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
