# ==============================================================================
# LedgerFlow Environment Configuration Template (.env.example)
#
# IMPORTANT:
# - This template contains PLACEHOLDERS ONLY. Do NOT commit real secrets to Git.
# - In production (NODE_ENV=production), ADMIN_TOKEN and WEBHOOK_SECRET must each
#   be at least 32 characters of high-entropy random data (e.g., generated with
#   `openssl rand -hex 32`). Insecure defaults will cause startup to fail fast.
# - In production, DEMO_MODE and ALLOW_PRIVATE_WEBHOOK_TARGETS must strictly be false.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. PostgreSQL Datastore
# ------------------------------------------------------------------------------
# In production, specify your hosted PostgreSQL connection string with TLS/SSL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD_PLACEHOLDER
POSTGRES_DB=ledgerflow
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:YOUR_POSTGRES_PASSWORD_PLACEHOLDER@localhost:5432/ledgerflow
DB_POOL_MAX=60

# Optional SSL configuration for managed database providers (AWS RDS, Supabase, Neon)
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# ------------------------------------------------------------------------------
# 3. Redis Cache & Queue Backend
# ------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 4. Authentication & Webhook Cryptography (MANDATORY IN PRODUCTION)
# Generate with: openssl rand -hex 32
# ------------------------------------------------------------------------------
# Master secret for HMAC-SHA256 signature generation on outbound webhooks
WEBHOOK_SECRET=YOUR_RANDOM_WEBHOOK_SECRET_MIN_32_CHARS_PLACEHOLDER

# Bearer token for administrative bootstrap endpoints (POST /admin/merchants)
ADMIN_TOKEN=YOUR_RANDOM_ADMIN_TOKEN_MIN_32_CHARS_PLACEHOLDER

# Bearer token required for scraping Prometheus metrics at GET /metrics (optional in dev, recommended in prod)
METRICS_TOKEN=YOUR_RANDOM_METRICS_BEARER_TOKEN_PLACEHOLDER

# ------------------------------------------------------------------------------
# 5. Security & Isolation Controls
# ------------------------------------------------------------------------------
# In production, this MUST be false to prevent Server-Side Request Forgery (SSRF).
# Setting this to true in NODE_ENV=production is strictly blocked and fails startup.
ALLOW_PRIVATE_WEBHOOK_TARGETS=false

# Interactive Chaos Simulator UI and destructive simulation endpoints (/demo/reset).
# Setting this to true in NODE_ENV=production is strictly blocked and fails startup.
DEMO_MODE=false

# ------------------------------------------------------------------------------
# 6. Idempotency Layer Configuration
# ------------------------------------------------------------------------------
IDEMPOTENCY_RETENTION_SECONDS=86400
IDEMPOTENCY_CLEANUP_INTERVAL_SECONDS=3600

# ------------------------------------------------------------------------------
# 7. Webhook Delivery & Circuit Breaker Thresholds
# ------------------------------------------------------------------------------
CIRCUIT_BREAKER_FAILURE_THRESHOLD=10
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
CIRCUIT_BREAKER_ERROR_RATE_THRESHOLD=0.5
WEBHOOK_RATE_LIMIT_PER_SECOND=10
WEBHOOK_RATE_LIMIT_BURST=20
WEBHOOK_MAX_CONCURRENT_PER_ENDPOINT=3
WEBHOOK_DELIVERY_TIMEOUT_MS=5000
WEBHOOK_WORKER_CONCURRENCY=10

# ------------------------------------------------------------------------------
# 8. Monitoring & Observability Stack (Prometheus / Grafana)
# ------------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=YOUR_GRAFANA_ADMIN_PASSWORD_PLACEHOLDER
GRAFANA_AUTH_ANONYMOUS_ENABLED=false
